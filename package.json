{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "author": {
    "name": "Parsa Rajabi",
    "url": "https://github.com/parsa-rajabi-nanami"
  },
  "packageManager": "pnpm@11.27.1",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm --filter @workspace/tint-pros-tampa dev",
    "typecheck:site": "pnpm --filter @workspace/tint-pros-tampa typecheck",
    "build:site": "pnpm --filter @workspace/tint-pros-tampa build",
    "build:pages": "pnpm --filter @workspace/tint-pros-tampa build:pages",
    "preview:site": "pnpm --filter @workspace/tint-pros-tampa serve",
    "deploy:pages": "pnpm run build:pages && gh-pages --dotfiles -d artifacts/tint-pros-tampa/dist/public",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "gh-pages": "6.3.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
